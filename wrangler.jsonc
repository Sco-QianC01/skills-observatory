{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skills-observatory",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "vars": {
    "FEED_URL": "https://raw.githubusercontent.com/Sco-QianC01/skills-observatory/main/public/data/feed.json"
  },
  "observability": { "enabled": true }
}
